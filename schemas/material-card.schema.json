{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaronkbragg7337.github.io/surface-material-lab/schemas/material-card.schema.json",
  "title": "Surface Material Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "status",
    "sourceType",
    "sourceFiles",
    "license",
    "realWorldWidthMeters",
    "realWorldHeightMeters",
    "defaultRepeat",
    "mappingMethods",
    "baseColorMap",
    "roughness",
    "metalness",
    "colorSpace",
    "seamless",
    "variants",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^MAT-[A-Z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "subcategory": { "type": ["string", "null"] },
    "description": { "type": "string" },
    "status": { "enum": ["draft", "processing", "prototype", "validation_required", "approved_distant", "approved_medium", "approved_closeup", "rejected", "deprecated"] },
    "sourceType": { "enum": ["user_photograph", "generated_image", "scan", "downloaded_resource", "procedural"] },
    "sourceFiles": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object" },
    "realWorldWidthMeters": { "type": "number", "exclusiveMinimum": 0 },
    "realWorldHeightMeters": { "type": "number", "exclusiveMinimum": 0 },
    "scaleStatus": { "enum": ["unverified", "estimated", "measured", "validated"] },
    "pixelsPerMeter": { "type": "number", "exclusiveMinimum": 0 },
    "defaultRepeat": { "type": "array", "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }], "minItems": 2, "maxItems": 2 },
    "mappingMethods": { "type": "array", "items": { "enum": ["uv", "planar", "box", "triplanar", "world"] }, "minItems": 1 },
    "baseColorMap": { "type": "string", "minLength": 1 },
    "normalMap": { "type": ["string", "null"] },
    "roughnessMap": { "type": ["string", "null"] },
    "heightMap": { "type": ["string", "null"] },
    "aoMap": { "type": ["string", "null"] },
    "metalnessMap": { "type": ["string", "null"] },
    "opacityMap": { "type": ["string", "null"] },
    "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
    "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
    "normalStrength": { "type": "number", "minimum": 0 },
    "heightStrength": { "type": "number", "minimum": 0 },
    "displacementScale": { "type": "number", "minimum": 0 },
    "colorSpace": { "enum": ["sRGB", "linear"] },
    "seamless": { "type": "boolean" },
    "tileabilityScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "physicalScaleValidated": { "type": "boolean" },
    "closeupValidated": { "type": "boolean" },
    "curvedSurfaceValidated": { "type": "boolean" },
    "verticalSurfaceValidated": { "type": "boolean" },
    "antiTilingEnabled": { "type": "boolean" },
    "variants": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "runtimeOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geometry": { "type": "string" },
        "lighting": { "type": "string" },
        "camera": { "type": "string" },
        "channel": { "type": "string" },
        "mapping": { "type": "string" },
        "repeatMultiplier": { "type": "number", "exclusiveMinimum": 0 },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "bumpStrength": { "type": "number", "minimum": 0 },
        "antiTilingEnabled": { "type": "boolean" }
      }
    },
    "createdAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string" }
  }
}
